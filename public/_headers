# Netlify cache headers (Vercel equivalent lives in vercel.json)
# Hashed build output never changes for a given filename
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their filename when replaced, so cache for a week and revalidate in the background
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
